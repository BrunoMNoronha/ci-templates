{
  "name": "fixture-node",
  "version": "1.0.0",
  "private": true,
  "description": "Projeto mínimo para o autoteste do node-ci.yml. Sem dependências.",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "node -e \"process.exit(0)\"",
